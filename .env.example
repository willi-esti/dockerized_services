# Log files
LOG_FILE=/opt/gaia/logs/info.log
ERROR_LOG=/opt/gaia/logs/error.log

# Root path
ROOT_PATH=/opt/gaia
BACKUP_PATH=/opt/gaia/backup
VAULT_PATH=/opt/gaia/vault

# Planka API
PLANKA_BASE_URL=https://192.168.255.6:445
PLANKA_USER=root
PLANKA_PWD=root
PLANKA_HOST=https://192.168.255.6

# PGAdmin
PGADMIN_DEFAULT_EMAIL=admin@gmail.com
PGADMIN_DEFAULT_PASSWORD=admin
PG_SERVER_NAME=gaia
PG_SERVER_HOST=postgres
PG_SERVER_PORT=5432
PG_SERVER_USER=gaia
PG_SERVER_PASSWORD=root

# Postgres
POSTGRES_DB=kronos
POSTGRES_PASSWORD=postgres
POSTGRES_USER=postgres

# Planka
PLANKA_SECRET_KEY=your_planka_secret_key
PLANKA_DEFAULT_ADMIN_EMAIL=root
PLANKA_DEFAULT_ADMIN_PASSWORD=root
PLANKA_DEFAULT_ADMIN_NAME=root
PLANKA_DEFAULT_ADMIN_USERNAME=root

# Wiki.js
WIKI_ADMIN_EMAIL=root
WIKI_ADMIN_PASS=root

# URLs
SERVER_ADMIN=admin@admin.com
SERVER_DOMAIN=192.168.255.6
WIKI_DOMAIN=192.168.255.6
PLANKA_DOMAIN=192.168.255.6
# openssl req -x509 -nodes -days 365 -newkey rsa:2048 -keyout privkey.pem -out fullchain.pem
SSL_CERTIFICATE_FILE=/opt/gaia/vault/certificate/fullchain.pem
SSL_CERTIFICATE_KEY_FILE=/opt/gaia/vault/certificate/privkey.pem